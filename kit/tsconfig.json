{
  // For editors and `tsc -p kit` only. /kit is not built here: sync.mjs copies
  // it into each plugin, which builds it with its own dependencies. This file
  // borrows the gallery plugin's (plugins/kit-gallery, after `npm install`
  // there) so a language server opened on /kit can resolve react, the SDK and
  // ../../lib/utils. sync.mjs does not copy it.
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "baseUrl": "../plugins/kit-gallery",
    "paths": {
      "@/*": ["./*"],
      // Its package.json maps this with "exports", which a path mapping does not read.
      "@get-bb/plugin-sdk/app": ["./node_modules/@get-bb/plugin-sdk/bundled-types/bb-plugin-sdk-app.d.ts"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    // kit/components/x.tsx imports ../../lib/utils: the plugin's lib once copied.
    "rootDirs": ["..", "../plugins/kit-gallery"],
    "typeRoots": ["../plugins/kit-gallery/node_modules/@types"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["."],
  "exclude": ["scripts", "node_modules"]
}
